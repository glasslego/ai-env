# ai-env 환경변수 설정
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요:
#   cp .env.example .env

# === AI Provider API Keys ===
# claude API
ANTHROPIC_API_KEY=
# codex API
OPENAI_API_KEY=

# === MCP Server Credentials ===
# Used by: brave-search
BRAVE_API_KEY=
# Used by: github
GITHUB_GLASSLEGO_TOKEN=
# Used by: github-kakao
GITHUB_TOKEN=
# SSE URL for: cdp-mcp-server
CDP_MCP_CBT_URL=
# SSE URL for: kkoto-mcp
KKOTO_MCP_URL=
# SSE URL for: supabase
SUPABASE_MCP_URL=

