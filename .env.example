# ai-env 환경변수 설정
# 이 파일을 .env로 복사한 뒤 실제 값을 입력하세요:
#   cp .env.example .env

# === AI Provider API Keys ===
# claude API
ANTHROPIC_API_KEY=
# codex API
OPENAI_API_KEY=

# === MCP Server Credentials ===
# Used by: brave-search
BRAVE_API_KEY=
# Used by: github
GITHUB_GLASSLEGO_TOKEN=
# Used by: github-kakao
GITHUB_TOKEN=
# Used by: jira-wiki-mcp
JIRA_TOKEN=
# Used by: jira-wiki-mcp
JIRA_URL=
# Used by: mem0
MEM0_API_KEY=
# Used by: jira-wiki-mcp
WIKI_BASE_URL=
# Used by: jira-wiki-mcp
WIKI_TOKEN=
# SSE URL for: cdp-mcp-server
CDP_MCP_URL=
# SSE URL for: kkoto-mcp
KKOTO_MCP_URL=

# === Extra Credentials ===
# Used by: research.py (Track B Gemini Deep Research)
GOOGLE_API_KEY=
# 한국은행 ECOS Open API (https://ecos.bok.or.kr/api/)
ECOS_API_KEY=

# === Optional ===
# CLAUDE_FALLBACK_LOG_DIR=.claude/logs
# CLAUDE_FALLBACK_RETRY_MINUTES=15
